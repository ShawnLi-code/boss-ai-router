{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boss AI Router",
  "version": "0.3.0",
  "identifier": "io.github.shawnlicode.bossairouter",
  "build": {
    "frontendDist": "./boot"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boss AI Router · 岗位风控与双号分流台",
        "width": 1340,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../src",
      "../public",
      "../package.json"
    ]
  }
}
