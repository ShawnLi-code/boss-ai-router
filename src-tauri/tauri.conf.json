{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boss AI Router",
  "version": "0.7.2",
  "identifier": "io.github.shawnlicode.bossairouter",
  "build": {
    "frontendDist": "./boot"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../src",
      "../public",
      "../package.json"
    ]
  }
}
